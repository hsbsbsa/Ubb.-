{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/promise.schema.json",
  "title": "Promise (setup/payoff ledger entry)",
  "description": "A narrative debt the story owes a payoff for (FR-3.4).",
  "type": "object",
  "required": ["id", "project_id", "type", "statement", "importance", "status", "due_window"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "project_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "type": { "type": "string", "enum": ["foreshadowing", "mystery", "chekhov", "relationship_beat", "character_goal", "world_question", "running_gag", "threat", "debt", "red_herring"] },
    "statement": { "$ref": "common.schema.json#/$defs/text" },
    "importance": { "type": "string", "enum": ["core", "major", "minor"] },
    "status": { "type": "string", "enum": ["planned", "open", "advanced", "paid", "abandoned"] },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "plan_ref": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }
      }
    },
    "due_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_chapter": { "type": "integer", "minimum": 1 },
        "max_chapter": { "type": "integer", "minimum": 1 },
        "arc_id": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "advances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id"],
        "additionalProperties": false,
        "properties": {
          "chapter_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "note": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }
        }
      }
    },
    "payoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" }, "minItems": 1 },
        "note": { "type": "string" }
      }
    },
    "abandon_reason": { "type": "string", "description": "Required when status=abandoned; user decision only" },
    "related_proposition_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "related_entity_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "resolution_hint": { "type": "string", "description": "Planned answer/payoff (plan frame; not canon)" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "paid" } } }, "then": { "required": ["payoff"] } },
    { "if": { "properties": { "status": { "const": "abandoned" } } }, "then": { "required": ["abandon_reason"] } }
  ]
}
