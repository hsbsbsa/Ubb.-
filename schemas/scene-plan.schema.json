{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/scene-plan.schema.json",
  "title": "Scene Plan",
  "description": "Drafting unit within a chapter (docs/03-story-planning/01 §8).",
  "type": "object",
  "required": [
    "scene_no",
    "objective",
    "pov",
    "participants",
    "location_id",
    "beats",
    "length_target",
    "speaker_pairs"
  ],
  "additionalProperties": false,
  "properties": {
    "scene_no": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string"
    },
    "pov": {
      "type": "object",
      "required": [
        "character_id",
        "person"
      ],
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "person": {
          "type": "string",
          "enum": [
            "first",
            "third_limited",
            "third_omniscient"
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 1
    },
    "location_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "story_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/storyClock"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/storyClock"
        },
        "elapsed_hint": {
          "type": "string"
        }
      }
    },
    "opening_beat_type": {
      "type": "string"
    },
    "ending_beat_type": {
      "type": "string"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "action",
              "dialogue",
              "revelation",
              "decision",
              "emotional",
              "comedic",
              "progression",
              "transition",
              "status_text",
              "cliffhanger"
            ]
          },
          "description": {
            "type": "string"
          },
          "emotional_target": {
            "type": "string"
          },
          "reveals_proposition_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "satisfaction",
                "emotion",
                "information",
                "humor",
                "growth",
                "tension"
              ]
            }
          }
        }
      }
    },
    "entry_state": {
      "type": "string"
    },
    "exit_state": {
      "type": "string"
    },
    "state_deltas": {
      "type": "array",
      "items": {
        "$ref": "chapter-contract.schema.json#/$defs/stateDelta"
      }
    },
    "dialogue_density_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "continuity_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "statement": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceRef"
            }
          }
        }
      }
    },
    "must_not": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "speaker_pairs": {
      "type": "array",
      "description": "Pre-resolved English dialogue register for pairs who will talk in this scene.",
      "items": {
        "type": "object",
        "required": [
          "speaker_id",
          "addressee_id",
          "register"
        ],
        "additionalProperties": false,
        "properties": {
          "speaker_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "addressee_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "register": {
            "$ref": "common.schema.json#/$defs/dialogueRegister",
            "description": "Pre-resolved English register for this pair at the scene's story time"
          },
          "allowed_shift": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "$ref": "common.schema.json#/$defs/registerShiftReason"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/dialogueRegister"
              }
            }
          },
          "source_relationship_state_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    "length_target": {
      "$ref": "common.schema.json#/$defs/lengthTarget"
    }
  }
}
