{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/speech-profile.schema.json",
  "title": "Speech Profile",
  "description": "Per-character baseline speech behavior (FR-2.6). Dynamic changes over story time are recorded as speech.* facts / relationship_states with validity.",
  "type": "object",
  "required": ["character_id", "version", "default_level", "by_counterpart"],
  "additionalProperties": false,
  "properties": {
    "character_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "default_level": { "$ref": "common.schema.json#/$defs/speechLevel" },
    "self_reference": { "type": "string", "enum": ["나", "저", "mixed_by_level"], "default": "mixed_by_level" },
    "by_counterpart": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["counterpart", "level", "address_terms"],
        "additionalProperties": false,
        "properties": {
          "counterpart": {
            "type": "object",
            "description": "A specific character or a class of counterparts.",
            "additionalProperties": false,
            "properties": {
              "entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
              "class": { "type": "string", "enum": ["elder", "younger", "peer", "superior", "subordinate", "stranger", "royalty", "master", "disciple", "family"] }
            }
          },
          "level": { "$ref": "common.schema.json#/$defs/speechLevel" },
          "address_terms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "honorific_subject": { "type": "boolean", "description": "Uses -시-/께서 toward this counterpart" },
          "valid_from_chapter": { "type": "integer", "minimum": 1 },
          "valid_to_chapter": { "type": "integer", "minimum": 1 },
          "note_ko": { "type": "string" }
        }
      }
    },
    "tics": { "type": "array", "items": { "type": "string" }, "description": "말버릇 (e.g., 문장 끝 '~거든요')" },
    "forbidden_expressions": { "type": "array", "items": { "type": "string" } },
    "register_shift_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "shift_to"],
        "additionalProperties": false,
        "properties": {
          "trigger": { "type": "string", "enum": ["anger", "intimacy_step", "disguise", "mockery", "public_formality", "age_reveal", "emotional_outburst"] },
          "shift_to": { "$ref": "common.schema.json#/$defs/speechLevel" },
          "note_ko": { "type": "string" }
        }
      }
    },
    "sentence_tendency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": { "type": "string", "enum": ["short", "medium", "long"] },
        "onomatopoeia": { "type": "string", "enum": ["none", "light", "heavy"] },
        "vocabulary_ko": { "type": "string", "description": "e.g. '임상 용어', '속담'" }
      }
    },
    "voice_exemplar_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" }, "maxItems": 5 }
  }
}
