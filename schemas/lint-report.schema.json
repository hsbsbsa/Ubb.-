{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/lint-report.schema.json",
  "title": "Korean Lint Report",
  "description": "Deterministic Korean lint + register check output for one manuscript version (docs/02-korean-style/04).",
  "type": "object",
  "required": ["manuscript_version_id", "style_profile_version_id", "analyzer_version", "metrics", "violations"],
  "additionalProperties": false,
  "properties": {
    "manuscript_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "style_profile_version_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "analyzer_version": { "type": "string" },
    "rules_version": { "type": "string" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "properties": {
        "char_count_incl_spaces": { "type": "number" },
        "char_count_excl_spaces": { "type": "number" },
        "sentence_count": { "type": "number" },
        "paragraph_count": { "type": "number" },
        "avg_sentence_chars": { "type": "number" },
        "sentence_length_stdev": { "type": "number" },
        "dialogue_ratio": { "type": "number" },
        "monologue_ratio": { "type": "number" },
        "third_person_pronoun_per_1000": { "type": "number" },
        "translation_marker_rate": { "type": "number" },
        "tagged_attribution_ratio": { "type": "number" },
        "adverb_tag_ratio": { "type": "number" },
        "max_ending_run": { "type": "number" },
        "top_ending_ratio": { "type": "number" },
        "max_exposition_run": { "type": "number" },
        "hook_sentence_index": { "type": "number" },
        "register_violation_rate": { "type": "number" }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "span", "message_ko"],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string", "pattern": "^(KL|TRN)-[A-Z0-9-]+$" },
          "severity": { "$ref": "common.schema.json#/$defs/severity" },
          "span": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "paragraph_ids": { "type": "array", "items": { "type": "string" } },
              "quote": { "type": "string" }
            }
          },
          "message_ko": { "type": "string" },
          "metric_value": { "type": "number" },
          "threshold": { "type": "number" },
          "register": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "speaker_id": { "$ref": "common.schema.json#/$defs/uuid" },
              "addressee_id": { "$ref": "common.schema.json#/$defs/uuid" },
              "detected_level": { "$ref": "common.schema.json#/$defs/speechLevel" },
              "expected_level": { "$ref": "common.schema.json#/$defs/speechLevel" },
              "source_relationship_state_id": { "$ref": "common.schema.json#/$defs/uuid" },
              "resolution_confidence": { "$ref": "common.schema.json#/$defs/confidence" }
            }
          }
        }
      }
    },
    "system_blocks_parsed": { "type": "integer", "minimum": 0 },
    "incremental_from_version_id": { "$ref": "common.schema.json#/$defs/uuid" }
  }
}
