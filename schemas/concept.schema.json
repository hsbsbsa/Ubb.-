{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/concept.schema.json",
  "title": "Concept Candidate",
  "description": "One story concept candidate produced by concept_generator (FR-2.1). Candidates are compared pairwise; the selected/merged concept seeds the Story Bible and Series Blueprint.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "spec_version",
    "angle",
    "logline",
    "story_promise",
    "reader_fantasy",
    "main_conflict",
    "chapter_one_hook",
    "ending_direction",
    "differentiators",
    "genre_fit_notes",
    "risk_notes",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "angle": {
      "type": "string",
      "description": "Diversity seed used for generation, e.g. satisfaction-driven / emotion-driven / mystery-driven"
    },
    "logline": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "story_promise": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "reader_fantasy": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "main_conflict": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "protagonist_sketch": {
      "type": "string"
    },
    "chapter_one_hook": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "ending_direction": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "progression_curve": {
      "type": "string",
      "description": "How power/status rises across the series, with rough milestones"
    },
    "differentiators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "genre_fit_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_coverage": {
      "type": "array",
      "description": "How each hard requirement is honored by this concept",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "how"
        ],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "selected",
        "merged_into",
        "rejected"
      ]
    },
    "merged_into_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "generator_call_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    }
  }
}
