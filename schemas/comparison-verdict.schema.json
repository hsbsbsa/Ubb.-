{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/comparison-verdict.schema.json",
  "title": "Comparison Verdict",
  "description": "Pairwise candidate judgment; run in both orders (ADR-0015). Evidence fields precede preferences to reduce rationalization.",
  "type": "object",
  "required": ["candidate_a_id", "candidate_b_id", "presentation_order", "dimensions", "overall_preference", "confidence"],
  "additionalProperties": false,
  "properties": {
    "candidate_a_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "candidate_b_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "presentation_order": { "type": "string", "enum": ["ab", "ba"] },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "evidence_a_ko", "evidence_b_ko", "preference"],
        "additionalProperties": false,
        "properties": {
          "dimension": { "type": "string", "enum": ["contract_fit", "continuity_risk", "korean_style", "hook", "emotional_impact", "pacing", "genre_fit", "originality", "reader_fantasy"] },
          "evidence_a_ko": { "type": "string" },
          "evidence_b_ko": { "type": "string" },
          "preference": { "type": "string", "enum": ["a", "b", "tie"] },
          "margin": { "type": "string", "enum": ["slight", "clear", "strong"] }
        }
      }
    },
    "overall_preference": { "type": "string", "enum": ["a", "b", "tie"] },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "rationale_ko": { "type": "string" },
    "judge_call_id": { "$ref": "common.schema.json#/$defs/uuid" }
  }
}
